# FlexiFees Environment Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control

# ============== M-PESA CONFIGURATION ==============
# Get these from Safaricom Developer Portal (https://developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_CALLBACK_URL=https://your-domain.com/api/v1/payments/callback

# ============== DATABASE ==============
# SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///./flexifees.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ============== ENVIRONMENT ==============
# sandbox or production
ENVIRONMENT=sandbox

# Enable debug mode (set to False in production)
DEBUG=True

# Use mock M-Pesa responses (set to False in production)
MOCK_MPESA=True

# ============== SECURITY ==============
# Secret key for signing (generate a strong random key)
SECRET_KEY=your-secret-key-here-minimum-32-characters

# API rate limiting
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60
