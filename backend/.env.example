# ===========================================
# EduPay - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control

# ===========================================
# M-PESA DARAJA 2.0 CONFIGURATION
# ===========================================
# Get credentials from: https://developer.safaricom.co.ke

# Consumer Key and Secret from your Daraja app
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Business Shortcode (Paybill or Till Number)
# Sandbox default: 174379
MPESA_SHORTCODE=174379

# Passkey provided by Safaricom for STK Push
# Sandbox default passkey:
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Callback URL - MUST be publicly accessible
# For localhost testing with ngrok:
#   1. Install ngrok: https://ngrok.com/download
#   2. Run: ngrok http 8000
#   3. Copy the HTTPS URL and add the callback path
# Example: https://abc123.ngrok.io/api/v1/payments/callback
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok.io/api/v1/payments/callback

# ===========================================
# DATABASE
# ===========================================
# SQLite (development - default)
DATABASE_URL=sqlite+aiosqlite:///./edupay.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/edupay

# ===========================================
# ENVIRONMENT SETTINGS
# ===========================================
# sandbox or production
ENVIRONMENT=sandbox

# Enable debug mode (set to false in production)
DEBUG=true

# Mock M-Pesa mode
# true = Use mock responses (no real API calls, good for UI testing)
# false = Use real Daraja API (requires valid credentials + ngrok)
MOCK_MPESA=true

# ===========================================
# QUICK START GUIDE
# ===========================================
# 
# STEP 1: Setup Environment
#   cp .env.example .env
#
# STEP 2: Get Daraja Credentials
#   - Go to https://developer.safaricom.co.ke
#   - Create account and new app
#   - Copy Consumer Key and Secret to .env
#
# STEP 3: Setup Callback URL (for real API testing)
#   - Install ngrok: https://ngrok.com/download
#   - Run: ngrok http 8000
#   - Copy HTTPS URL to MPESA_CALLBACK_URL
#   - Example: https://a1b2c3d4.ngrok.io/api/v1/payments/callback
#
# STEP 4: Test with Mock Mode First
#   - Keep MOCK_MPESA=true
#   - Run: cd backend && uvicorn app.main:app --reload
#   - Open: http://localhost:8000/docs
#   - Test STK Push endpoint
#
# STEP 5: Test with Real API
#   - Set MOCK_MPESA=false
#   - Ensure ngrok is running
#   - Use Safaricom test credentials
#   - Test phone: Use your own Safaricom number
#
# ===========================================
